@page
@model TeenHangout.Pages.IndexModel
@{
    ViewData["Title"] = "Teen Hangout";
}


<div class="container">

    <h1 class="text-center">Teen Hangout</h1>
    <p class="text-center">Your virtual space to connect!</p>

    @* Shows every member *@
    <h2>Our Members</h2>
    @foreach (var user in Model.Users)
    {
        <div class="alert alert-secondary">
            <strong>@user.Username</strong>, Age: @user.Age, Favorite Color: @user.FavoriteColor
        </div>
    }

    @* Shows every post. *@
    <h2>Recent Posts</h2>
    @foreach (var post in Model.Posts)
    {
        <div class="alert alert-info">
            <strong>@post.Username</strong>
            <p>@post.Content</p>
            <small>Likes: @post.Likes</small>
        </div>
    }

    @* Shows only posts with more than 20 likes *@
    <h2>Popular Posts (20+ Likes)</h2>
    @foreach (var post in Model.Posts)
    {
        if (post.Likes >= 20)
        @*Checks if the number of likes on the post is more than or equal to 20.*@
        {
            <div class="alert alert-success">
                <strong>@post.Username</strong>
                <p>@post.Content</p>
                <small>Likes: @post.Likes</small>
            </div>
        }
    }

    <h2>Members 16 or Older</h2>
    @foreach (var user in Model.Users)
    {
        if (user.Age >= 16)
        @*Checks if the age of the user is equal or above 16.*@
        {
            <div class="alert alert-warning">
                <strong>@user.Username</strong>
                <p>Age: @user.Age</p>
            </div>
        }
    }
    @*Module 6 Coding Challenge
    Added a section of the webpage that displays a list of users who are 16 or older. *@


    <h2>Posts with fewer than 20 likes</h2>
    @foreach (var post in Model.Posts)
    {
        if(post.Likes < 20)
        @*Checks if the number of likes on each post is less than 20*@
        {
            <div class="alert alert-dark">
                <strong>@post.Username</strong>
                <p>@post.Content</p>
                <small>Likes: @post.Likes</small>
            </div>
        }
    }
    @*Module 6 Coding Challenge.
    Added a section of the webpage that displays a list of posts with less than 20 likes.*@
</div>